swap(address,bool,int256,uint160,bytes)\":{\"details\":\"Mirrors real Agni/UniswapV3 pools: compute the output from current      state first, invoke the callback so the caller pays the input, verify      it actually arrived, then pay the output last.\"}},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"seed(uint160,uint128)\":{\"notice\":\"One-time bootstrap: the pool must already hold enough of both         tokens to back the requested full-range liquidity at `initialSqrtPriceX96`.\"}},\"notice\":\"Full-range virtual-reserve Agni/Uniswap-V3-style pool, deployed as a         WHI-525 E2E fixture only \\u2014 never a production DEX contract.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/fixtures/E2EFixturePoolAgniV3.sol\":\"E2EFixturePoolAgniV3\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":forge-std/=lib/forge-std/src/\"],\"viaIR\":true},\"sources\":{\"src/fixtures/E2EFixturePoolAgniV3.sol\":{\"keccak256\":\"0xd2513ded2ebe726d7cc7adce2f5b575061dea1ef6b22e8ce9648db559846cd80\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://e09afb286088e801aa1a94a05b3bab3effd7606c5f688affedf19d0586aa1eca\",\"dweb:/ipfs/QmbTEWJH5NUCpiqfBH8WenPLaJTiXtP4mpqKYS2R9pcgax\"]},\"src/fixtures/IFixtureERC20Transferable.sol\":{\"keccak256\":\"0xe38a89f6349419c15a0d86f0c4112bc3f2fdddc856e06503b1b3d9d1d0242351\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://c9d2df7cea15cb06fd55c1a3e26a06c5798dc8015cdda56204d06236a62cbaf9\",\"dweb:/ipfs/QmP6GaqS65m997EixfzvS7WrCHmdAsytPDGiWNUFvdt151\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.26+commit.8a97fa7a"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"address","name":"token0_","type":"address"},{"internalType":"address","name":"token1_","type":"address"},{"internalType":"uint24","name":"fee_","type":"uint24"}],"stateMutability":"nonpayable","type":"constructor"},{"inputs":[],"type":"error","name":"Alre