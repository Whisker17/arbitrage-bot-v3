# WHI-715 continuous mainnet shadow — copy values into the gitignored root `.env`.
# Never commit real RPC URLs or keys.
#
# WHI-776: expected chain id (mainnet). Bot fails closed on mismatch.
# Endpoint precedence: RPC_* override → MANTLE_MAINNET_* → MANTLE_RPC_* →
# MANTLE_HTTP_URL/MANTLE_WS_URL → default. Sepolia vars are never consulted.
BOT_CHAIN_ID=5000

# Preferred mainnet RPC pair (HTTP + WS). Canonical names (WHI-776):
MANTLE_MAINNET_RPC_URL=https://YOUR_MAINNET_HTTP_RPC
MANTLE_MAINNET_RPC_WS_URL=wss://YOUR_MAINNET_WS_RPC

# Legacy aliases still accepted when the canonical pair is unset:
# MANTLE_RPC_URL=https://YOUR_MAINNET_HTTP_RPC
# MANTLE_RPC_WS_URL=wss://YOUR_MAINNET_WS_RPC

# Shadow-safe placeholder executor (no funds, no keys). Override only if you
# have a verified shadow-compatible target; do NOT put a funded hot key here.
ARBITRAGE_EXECUTOR_ADDRESS=0x0000000000000000000000000000000000000002

# Required for signerless shadow context construction. Launcher defaults to the
# committed mainnet thresholds file if unset.
MANTLE_MAINNET_SHADOW_THRESHOLDS_PATH=config/gas_profiles/shadow_thresholds.mantle_mainnet.json

# MUST remain unset for continuous shadow:
# MANTLE_SEPOLIA_PRIVATE_KEY=
# MANTLE_MAINNET_PRIVATE_KEY=
# MANTLE_PRIVATE_KEY=
# PRIVATE_KEY=
# EXECUTION_PRIVATE_KEY=
