# Mantle Sepolia 测试网配置
# 复制此文件为 .env 并填写实际值

# RPC 端点
MANTLE_SEPOLIA_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_SEPOLIA_RPC_WS_URL=wss://ws.sepolia.mantle.xyz

# 私钥（不要包含 0x 前缀）
MANTLE_SEPOLIA_PRIVATE_KEY=your_private_key_without_0x_prefix

# ArbitrageExecutor 合约地址（部署后填写）
ARBITRAGE_EXECUTOR_ADDRESS=

# 可选：自定义日志路径
POOL_UPDATE_LOG=logs/sepolia_pool_updates.csv
POSITIVE_PATH_SIM_LOG=logs/positive_path_simulations.csv
