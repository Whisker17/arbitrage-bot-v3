# Mantle Sepolia 测试网配置
# 复制此文件为 .env 并填写实际值
#
# WHI-776: declare the expected chain id. The bot fails closed if the connected
# RPC reports a different id. Endpoint selection is chain-aware — with
# BOT_CHAIN_ID=5003 only Sepolia vars (and explicit RPC_* overrides) are
# consulted; MANTLE_MAINNET_* / MANTLE_RPC_* are ignored.
#
# Precedence (HTTP / WS):
#   1. RPC_HTTP_URL / RPC_WS_URL          (explicit override)
#   2. MANTLE_SEPOLIA_RPC_URL / _WS_URL   (chain-specific)
#   3. MANTLE_HTTP_URL / MANTLE_WS_URL    (legacy generic)
#   4. built-in Sepolia default
BOT_CHAIN_ID=5003

# RPC 端点
MANTLE_SEPOLIA_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_SEPOLIA_RPC_WS_URL=wss://ws.sepolia.mantle.xyz

# 私钥（不要包含 0x 前缀）
MANTLE_SEPOLIA_PRIVATE_KEY=your_private_key_without_0x_prefix

# ArbitrageExecutor 合约地址（部署后填写）
ARBITRAGE_EXECUTOR_ADDRESS=

# 可选：自定义日志路径
POOL_UPDATE_LOG=logs/sepolia_pool_updates.csv
POSITIVE_PATH_SIM_LOG=logs/positive_path_simulations.csv

# WHI-555: E2E-only typed transaction capability layer (src/execution/e2e/).
# Separate namespace from MANTLE_SEPOLIA_* above — the E2E startup validator
# reads only these three variables and refuses to start if any of
# MANTLE_SEPOLIA_PRIVATE_KEY, MANTLE_MAINNET_PRIVATE_KEY, MANTLE_PRIVATE_KEY,
# or PRIVATE_KEY are present in the environment at all, to avoid ambiguity
# between a legacy/production credential and the dedicated E2E signer. Only
# ever set these for Mantle Sepolia (chain id 5003); the startup validator
# rejects chain id 5000 (mainnet) unconditionally.
MANTLE_SEPOLIA_E2E_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_SEPOLIA_E2E_PRIVATE_KEY=your_e2e_only_private_key_without_0x_prefix
MANTLE_SEPOLIA_E2E_EXECUTOR_ADDRESS=

# WHI-532: Prometheus scrape endpoint for `cargo run --bin bot`.
# Process-local (not chain-scoped). The endpoint is UNAUTHENTICATED and
# unencrypted; default is loopback-only. Non-loopback binds require
# BOT_METRICS_ALLOW_PUBLIC_BIND=1 and an authenticating reverse proxy.
# BOT_METRICS_ADDR=127.0.0.1:9464
# BOT_METRICS_ALLOW_PUBLIC_BIND=0
# BOT_NO_METRICS=0
# BOT_METRICS_HOLD=0

# WHI-786 / WHI-921: production HTTP RPC hardening (throttle / retry / timeout).
# Default throttle is 8 RPS (WHI-862 measured at 59 pools on Mantle public RPC).
# Units: throttle is requests/sec, timeouts in ms. See CLAUDE.md for the
# pool-count scaling rationale (WHI-921).
# RPC_HTTP_THROTTLE_RPS=8
# RPC_HTTP_RETRY_MAX=5
# RPC_HTTP_RETRY_INITIAL_BACKOFF_MS=200
# RPC_HTTP_RETRY_CUPS=330
# RPC_HTTP_REQUEST_TIMEOUT_MS=30000
