use serde::{Deserialize, Serialize};
use std::{
    collections::{HashMap, HashSet},
    future::Future,
};
use tracing::info;

// --- Solidity interface definitions for MOE LBT ---

sol! {
    // ILBFactory interface
    #[allow(missing_docs)]
    #[derive(Debug, PartialEq, Eq)]
    #[sol(rpc)]
    contract ILBFactory {
        event LBPairCreated(
            address indexed tokenX,
            address indexed tokenY,
            uint256 indexed binStep,
            address LBPair
        );
    }

    // ILBPair events and functions interface
    #[derive(Debug, PartialEq, Eq)]
    #[sol(rpc)]
    contract ILBPairEvents {
        event Swapped(
            address indexed sender,
            address indexed to,
            uint24 id,
            uint256 amountIn,
            uint256 amountOut,
            uint256 volatileAmounts,
            uint256 fees
        );

        event Deposited(
            address indexed to,
            uint24 indexed id,
            uint256 amountsIn,
            uint256 amountsAdded
        );

        event Withdrawn(
            address indexed from,
            uint24 indexed id,
            uint256 amounts,
            uint256 amountsRemoved
        );
    }

    #[derive(Debug, PartialEq, Eq)]
    #[sol(rpc)]
    contract ILBPair {
        function getTokenX() external view returns (address);
        function getTokenY() external view returns (address);
        function getReserves() external view returns (uint256 reserveX, uint256 reserveY);
        function getActiveId() external view returns (uint24);
        function getBinStep() external view returns (uint16);
    }
}

// --- Batch request contract definitions ---

sol! {
    #[sol(rpc)]
    GetMoeLbtPoolDataBatchRequest,
    "src/amms/abi/GetMoeLbtPoolDataBatchRequest.json" // ABI from previous response
}

sol! {
    #[sol(rpc)]
    GetMoeLbtBinDataBatchRequest,
    "src/amms/abi/GetMoeLbtBinDataBatchRequest.json" // ABI for the new contract above
}

// --- Core structs for LBT Pool and Factory ---

#[derive(Debug, Clone, Default, Serialize, Deserialize)]
pub struct BinInfo {
    pub reserve_x: U256,
    pub reserve_y: U256,
}

#[derive(Debug, Clone, Default, Serialize, Deserialize)]
pub struct MoeLbtPool {
    pub address: Address,
    pub token_x: Token,
    pub token_y: Token,
    pub reserve_x: U256,
    pub reserve_y: U256,
    pub active_id: u32,
    pub bin_step: u16,
    pub bins: HashMap<u32, BinInfo>,
}

// --- AutomatedMarketMaker Trait Implementation for MoeLbtPool ---

impl AutomatedMarketMaker for MoeLbtPool {
    fn address(&self) -> Address {
        self.address
    }

    fn sync_events(&self) -> Vec<B256> {
        vec![
            ILBPairEvents::Swapped::SIGNATURE_HASH,
            ILBPairEvents::Deposited::SIGNATURE_HASH,
            ILBPairEvents::Withdrawn::SIGNATURE_HASH,
        ]
    }

    fn sync(&mut self, log: &Log) -> Result<(), AMMError> {
        let event_signature = log.topics()[0];
        match event_signature {
            ILBPairEvents::Swapped::SIGNATURE_HASH => {
                let swap_event = ILBPairEvents::Swapped::decode_log(log.as_ref())?;
                self.active_id = swap_event.id;
                // Note: LBT swap event doesn't directly give total reserves.
                // A full sync would be safer, but for high-frequency updates,
                // we can try to approximate the reserve change.
                // For now, we rely on batch syncing for accurate reserves.
                info!(
                    target = "amms::moe_lbt::sync",
                    address = ?self.address,
                    active_id = ?self.active_id,
                    "Swap"
                );
            }
            ILBPairEvents::Deposited::SIGNATURE_HASH => {
                let deposit_event = ILBPairEvents::Deposited::decode_log(log.as_ref())?;
                let bin = self.bins.entry(deposit_event.id).or_default();
                // `amountsAdded` is a packed value: (amountX << 128) | amountY
                let amount_x = deposit_event.amountsAdded >> 128;
                let amount_y = deposit_event.amountsAdded & ((U256::from(1) << 128) - U256::from(1));
                bin.reserve_x += amount_x;
                bin.reserve_y += amount_y;
                self.reserve_x += amount_x;
                self.reserve_y += amount_y;
            }
            ILBPairEvents::Withdrawn::SIGNATURE_HASH => {
                let withdraw_event = ILBPairEvents::Withdrawn::decode_log(log.as_ref())?;
                let bin = self.bins.entry(withdraw_event.id).or_default();
                // `amountsRemoved` is a packed value
                let amount_x = withdraw_event.amountsRemoved >> 128;
                let amount_y = withdraw_event.amountsRemoved & ((U256::from(1) << 128) - U256::from(1));
                bin.reserve_x -= amount_x;
                bin.reserve_y -= amount_y;
                self.reserve_x -= amount_x;
                self.reserve_y -= amount_y;
            }
            _ => return Err(AMMError::UnrecognizedEventSignature(event_signature)),
        }
        Ok(())
    }

    fn simulate_swap(
        &self,
        base_token: Address,
        _quote_token: Address,
        amount_in: U256,
    ) -> Result<U256, AMMError> {
        let zero_for_one = base_token == self.token_x.address;
        let mut current_id = self.active_id;
        let mut amount_remaining = amount_in;
        let mut amount_out = U256::ZERO;

        loop {
            if amount_remaining.is_zero() {
                break;
            }
            
            let bin = match self.bins.get(&current_id) {
                Some(b) => b,
                None => break, // No more liquidity in this direction
            };

            let price = self.get_price_at_id(current_id)?;

            if zero_for_one { // Swapping token X for Y
                if bin.reserve_y.is_zero() { break; }

                let amount_in_to_fill_bin = (bin.reserve_y * U256::from(10).pow(U256::from(18))) / price;
                
                if amount_remaining >= amount_in_to_fill_bin {
                    amount_out += bin.reserve_y;
                    amount_remaining -= amount_in_to_fill_bin;
                    current_id -= 1;
                } else {
                    let portion_out = (amount_remaining * price) / U256::from(10).pow(U256::from(18));
                    amount_out += portion_out;
                    amount_remaining = U256::ZERO;
                }
            } else { // Swapping token Y for X
                if bin.reserve_x.is_zero() { break; }
                
                let amount_in_to_fill_bin = (bin.reserve_x * price) / U256::from(10).pow(U256::from(18));
                
                if amount_remaining >= amount_in_to_fill_bin {
                    amount_out += bin.reserve_x;
                    amount_remaining -= amount_in_to_fill_bin;
                    current_id += 1;
                } else {
                    let portion_out = (amount_remaining * U256::from(10).pow(U256::from(18))) / price;
                    amount_out += portion_out;
                    amount_remaining = U256::ZERO;
                }
            }
        }
        Ok(amount_out)
    }

    fn calculate_price(&self, base_token: Address, _quote_token: Address) -> Result<f64, AMMError> {
        let price_1_for_0 = self.get_price_at_id(self.active_id)?
            .to_string()
            .parse::<f64>()
            .unwrap_or(0.0) / 10f64.powi(18);

        let price_adjusted_for_decimals = price_1_for_0 * 10f64.powi(self.token_x.decimals as i32 - self.token_y.decimals as i32);
        
        if base_token == self.token_y.address {
            Ok(price_adjusted_for_decimals)
        } else {
            Ok(1.0 / price_adjusted_for_decimals)
        }
    }
    
    // `simulate_swap_mut` can be implemented similarly if needed
    fn simulate_swap_mut(&mut self, _base_token: Address, _quote_token: Address, _amount_in: U256) -> Result<U256, AMMError> {
        // TODO: Implement mutable swap simulation if required
        Err(AMMError::NotImplemented)
    }

    fn tokens(&self) -> Vec<Address> {
        vec![self.token_x.address, self.token_y.address]
    }
}

impl MoeLbtPool {
    pub fn new(address: Address) -> Self {
        Self { address, ..Default::default() }
    }
    
    // Helper function to calculate price for a given bin ID
    // Price is for token Y in terms of token X (Y/X)
    fn get_price_at_id(&self, id: u32) -> Result<U256, AMMError> {
        // Using f64 for exponentiation, then converting to U256 for precision with large numbers
        let base: f64 = 1.0 + (self.bin_step as f64 / 10000.0);
        let exponent = id as i32 - (1 << 23); // 2^23 is the offset for id
        let price_float = base.powi(exponent);

        // Convert to U256 with 18 decimals of precision
        let price_u256 = U256::from((price_float * 10f64.powi(18)) as u128);
        Ok(price_u256)
    }
}

#[derive(Debug, Clone, Serialize, Deserialize, Hash, PartialEq, Eq)]
pub struct MoeLbtFactory {
    pub address: Address,
    pub creation_block: u64,
}

impl MoeLbtFactory {
    pub fn new(address: Address, creation_block: u64) -> Self {
        Self { address, creation_block }
    }

    pub async fn sync_all_pools<N, P>(
        mut pools: Vec<AMM>,
        block_number: BlockId,
        provider: P,
    ) -> Result<Vec<AMM>, AMMError>
    where
        N: Network,
        P: Provider<N> + Clone,
    {
        // Step 1: Sync basic pool data (reserves, active_id, bin_step)
        Self::sync_pool_data(&mut pools, block_number, provider.clone()).await?;
        Self::sync_token_decimals(&mut pools, provider.clone()).await?;

        // Step 2: Filter out inactive pools
        pools = pools
            .into_iter()
            .filter(|pool| match pool {
                AMM::MoeLbtPool(lbt_pool) => {
                    !lbt_pool.reserve_x.is_zero() && !lbt_pool.reserve_y.is_zero() && lbt_pool.token_x.decimals > 0 && lbt_pool.token_y.decimals > 0
                }
                _ => true,
            })
            .collect();
        
        // Step 3: Sync liquidity data for bins around the active_id
        Self::sync_bin_data(&mut pools, block_number, provider.clone()).await?;

        Ok(pools)
    }

    async fn sync_pool_data<N, P>(
        pools: &mut [AMM],
        block_number: BlockId,
        provider: P,
    ) -> Result<(), AMMError>
    where
        N: Network,
        P: Provider<N> + Clone,
    {
        let step = 250; // Adjust batch size as needed
        let mut futures = FuturesUnordered::new();
        pools.chunks_mut(step).for_each(|group| {
            let provider = provider.clone();
            let pool_addresses = group.iter().map(|pool| pool.address()).collect::<Vec<_>>();

            futures.push(async move {
                let call = GetMoeLbtPoolDataBatchRequest::deploy_builder(provider, pool_addresses);
                let return_data = call.call_raw().block(block_number).await?;
                Ok::<(&mut [AMM], Bytes), AMMError>((group, return_data))
            });
        });
        
        type PoolData = (Address, Address, U256, U256, u32, u16, u8, u8);
        while let Some(res) = futures.next().await {
            let (pools, return_data) = res?;
            let decoded_data = <Vec<PoolData> as SolValue>::abi_decode(&return_data)?;
            for (data, pool) in decoded_data.iter().zip(pools.iter_mut()) {
                if let AMM::MoeLbtPool(ref mut lbt_pool) = pool {
                    lbt_pool.reserve_x = data.2;
                    lbt_pool.reserve_y = data.3;
                    lbt_pool.active_id = data.4;
                    lbt_pool.bin_step = data.5;
                }
            }
        }
        Ok(())
    }

    async fn sync_token_decimals<N, P>(
        pools: &mut [AMM],
        provider: P,
    ) -> Result<(), BatchContractError>
    where
        N: Network,
        P: Provider<N> + Clone,
    {
        let mut tokens = HashSet::new();
        for pool in pools.iter() {
            tokens.extend(pool.tokens());
        }
        let token_decimals = get_token_decimals(tokens.into_iter().collect(), provider).await?;

        for pool in pools.iter_mut() {
            if let AMM::MoeLbtPool(ref mut lbt_pool) = pool {
                if let Some(decimals) = token_decimals.get(&lbt_pool.token_x.address) {
                    lbt_pool.token_x.decimals = *decimals;
                }
                if let Some(decimals) = token_decimals.get(&lbt_pool.token_y.address) {
                    lbt_pool.token_y.decimals = *decimals;
                }
            }
        }
        Ok(())
    }
    
    async fn sync_bin_data<N, P>(
        pools: &mut [AMM],
        block_number: BlockId,
        provider: P,
    ) -> Result<(), AMMError>
    where
        N: Network,
        P: Provider<N> + Clone,
    {
        let mut futures = FuturesUnordered::new();
        let step = 50; // Batch size for pools
        
        // Prepare requests for batching
        let bin_requests = pools.par_iter().filter_map(|pool| {
            if let AMM::MoeLbtPool(p) = pool {
                let active_id = p.active_id;
                // Fetch 20 bins on each side of the active one
                let start_id = active_id.saturating_sub(20);
                let end_id = active_id.saturating_add(20);
                let ids: Vec<u32> = (start_id..=end_id).collect();
                
                Some(GetMoeLbtBinDataBatchRequest::BinInfoRequest {
                    pool: p.address,
                    ids,
                })
            } else { None }
        }).collect::<Vec<_>>();
        
        for group in bin_requests.chunks(step) {
            let provider = provider.clone();
            let requests = group.to_vec();
            futures.push(async move {
                let call = GetMoeLbtBinDataBatchRequest::deploy_builder(provider, requests.clone());
                let return_data = call.call_raw().block(block_number).await?;
                Ok::<(Vec<GetMoeLbtBinDataBatchRequest::BinInfoRequest>, Bytes), AMMError>((requests, return_data))
            });
        }
        
        let mut pool_map: HashMap<Address, &mut AMM> = pools.iter_mut().map(|p| (p.address(), p)).collect();
        type BinReserves = (U256, U256);
        
        while let Some(res) = futures.next().await {
            let (requests, return_data) = res?;
            let decoded_data = <Vec<Vec<BinReserves>> as SolValue>::abi_decode(&return_data)?;

            for (req, reserves_vec) in requests.iter().zip(decoded_data.iter()) {
                if let Some(AMM::MoeLbtPool(ref mut lbt_pool)) = pool_map.get_mut(&req.pool) {
                    for (id, reserves) in req.ids.iter().zip(reserves_vec.iter()) {
                        lbt_pool.bins.insert(*id, BinInfo {
                            reserve_x: reserves.0,
                            reserve_y: reserves.1,
                        });
                    }
                }
            }
        }

        Ok(())
    }
}

impl AutomatedMarketMakerFactory for MoeLbtFactory {
    type PoolVariant = MoeLbtPool;

    fn address(&self) -> Address {
        self.address
    }

    fn pool_creation_event(&self) -> B256 {
        ILBFactory::LBPairCreated::SIGNATURE_HASH
    }

    fn create_pool(&self, log: Log) -> Result<AMM, AMMError> {
        let created_event = ILBFactory::LBPairCreated::decode_log(&log.inner)?;
        Ok(AMM::MoeLbtPool(MoeLbtPool {
            address: created_event.LBPair,
            token_x: created_event.tokenX.into(),
            token_y: created_event.tokenY.into(),
            bin_step: created_event.binStep.to::<u16>(),
            ..Default::default()
        }))
    }

    fn creation_block(&self) -> u64 {
        self.creation_block
    }
}

impl DiscoverySync for MoeLbtFactory {
    fn discover<N, P>(&self, to_block: BlockId, provider: P) -> impl Future<Output = Result<Vec<AMM>, AMMError>>
    where
        N: Network,
        P: Provider<N> + Clone,
    {
        async move {
            info!(target: "amms::moe_lbt::discover", address = ?self.address, "Discovering all LBPair pools");
            
            let filter = Filter::new()
                .event_signature(self.pool_creation_event())
                .address(self.address());
            
            let logs = provider.get_logs_paginated(&filter, self.creation_block, to_block.as_u64().unwrap_or(0)).await?;
            
            let pools = logs.into_iter().map(|log| self.create_pool(log)).collect::<Result<Vec<_>, _>>()?;
            Ok(pools)
        }
    }

    fn sync<N, P>(&self, amms: Vec<AMM>, to_block: BlockId, provider: P) -> impl Future<Output = Result<Vec<AMM>, AMMError>>
    where
        N: Network,
        P: Provider<N> + Clone,
    {
        info!(target: "amms::moe_lbt::sync", address = ?self.address, "Syncing all LBPair pools");
        Self::sync_all_pools(amms, to_block, provider)
    }
}

