# Mantle mainnet configuration (WHI-776)
# Copy to `.env` and fill in real values. Never commit real URLs or keys.
#
# Declare the expected chain id. The bot fails closed if the connected RPC
# reports a different id (e.g. accidentally pointing at Sepolia 5003).
# Endpoint selection follows this id — mainnet vars are used; Sepolia vars are
# never consulted when BOT_CHAIN_ID=5000.
#
# Precedence (HTTP / WS):
#   1. RPC_HTTP_URL / RPC_WS_URL                (explicit override)
#   2. MANTLE_MAINNET_RPC_URL / _WS_URL         (canonical chain-specific)
#   3. MANTLE_RPC_URL / MANTLE_RPC_WS_URL       (legacy mainnet alias; WHI-745)
#   4. MANTLE_HTTP_URL / MANTLE_WS_URL          (legacy generic)
#   5. built-in mainnet default
BOT_CHAIN_ID=5000

# Preferred mainnet RPC pair (HTTP + WS).
MANTLE_MAINNET_RPC_URL=https://YOUR_MAINNET_HTTP_RPC
MANTLE_MAINNET_RPC_WS_URL=wss://YOUR_MAINNET_WS_RPC

# Legacy aliases still accepted when the canonical pair is unset:
# MANTLE_RPC_URL=https://YOUR_MAINNET_HTTP_RPC
# MANTLE_RPC_WS_URL=wss://YOUR_MAINNET_WS_RPC

# ArbitrageExecutor contract address (deployed mainnet executor)
ARBITRAGE_EXECUTOR_ADDRESS=

# WHI-532: Prometheus scrape endpoint for `cargo run --bin bot`.
# Process-local (not chain-scoped). The endpoint is UNAUTHENTICATED and
# unencrypted; default is loopback-only. Non-loopback binds require
# BOT_METRICS_ALLOW_PUBLIC_BIND=1 and an authenticating reverse proxy.
# BOT_METRICS_ADDR=127.0.0.1:9464
# BOT_METRICS_ALLOW_PUBLIC_BIND=0
# BOT_NO_METRICS=0
# BOT_METRICS_HOLD=0

# WHI-786 / WHI-921: production HTTP RPC hardening (throttle / retry / timeout).
# Default throttle is 8 RPS (WHI-862 measured sustainable rate at 59 pools on
# Mantle public RPC). At 137 pools the WHI-862-scaled recommendation is 4 RPS
# (`recommended_throttle_rps`); the bot logs throttle_rps + pool_count at startup.
# Do not set this back to 250 — that produced a 429 storm + CreateContractSizeLimit
# on the 137-pool universe (WHI-921).
# RPC_HTTP_THROTTLE_RPS=8
# RPC_HTTP_RETRY_MAX=5
# RPC_HTTP_RETRY_INITIAL_BACKOFF_MS=200
# RPC_HTTP_RETRY_CUPS=330
# RPC_HTTP_REQUEST_TIMEOUT_MS=30000

# WHI-739 / WHI-535: shadow ledger (signerless). Required for --ledger.
# MANTLE_MAINNET_SHADOW_THRESHOLDS_PATH=config/gas_profiles/shadow_thresholds.mantle_mainnet.json
# SHADOW_LEDGER_PATH=logs/shadow_ledger.jsonl

# WHI-952 / G-5: independent size caps for the two unbounded streams.
# Segment rotation renames active → path.1, path.2, …; retention deletes oldest
# until total (active + rotated) ≤ MAX_TOTAL. Defaults: 64 MiB segment / 512 MiB total.
# Force-rotation tests use tiny thresholds; do not rely on "24h never hit the cap".
# SHADOW_LEDGER_MAX_SEGMENT_BYTES=67108864
# SHADOW_LEDGER_MAX_TOTAL_BYTES=536870912
# LOG_MAX_SEGMENT_BYTES=67108864
# LOG_MAX_TOTAL_BYTES=536870912

# MUST remain unset for signerless shadow mode (SHADOW_MODE=1):
# MANTLE_SEPOLIA_PRIVATE_KEY=
# MANTLE_MAINNET_PRIVATE_KEY=
# MANTLE_PRIVATE_KEY=
# PRIVATE_KEY=
# EXECUTION_PRIVATE_KEY=
#
# WHI-861 custody: after admin is transferred to a cold key, do NOT keep a key
# with onlyAdmin powers on this host. The former deploy key may be retained only
# as the execute-only hot signer (see BOT_HOT_EXECUTOR_PRIVATE_KEY below).
# One-shot handoff signing (current admin, before transferAdmin lands):
# CURRENT_ADMIN_PRIVATE_KEY=   # preferred by scripts/executor/execute_admin_transfer.sh
#
# WHI-860 production send path (default OFF). Opt in only after WHI-535 Approve
# and WHI-861 custody hardening. Never put the key in argv.
# BOT_ENABLE_SENDS=0
# BOT_HOT_EXECUTOR_PRIVATE_KEY=   # hot executor only — must ≠ contract admin
# BOT_SENDS_KILLED=0             # in-process kill switch (1 = halt sends)
# BREAKER_STORE_DIR=data/breaker
# MAX_LOSS_PER_WINDOW_WEI=
# MAX_INPUT_PER_TX_WMNT_WEI=
# MAX_TOTAL_INVENTORY_WMNT_WEI=
# WHI-950 / G-3 capital bounds (precondition ≠ input cap):
#   precondition: executor_balance <= MAX_TOTAL_INVENTORY (else block unsendable)
#   production: min(balance, MAX_INPUT_PER_TX, APPROVED_STRATEGY_CAP)
#   canary:     min(balance, MAX_INPUT_PER_TX, APPROVED_CANARY_NOTIONAL)
#   shadow:     SHADOW_ASSUMED_CAPITAL_CAP only (never reads chain balance)
# Balance-read strategy A: one hash-pinned balanceOf per block (metrics stage
# `balance_read`), reused by discovery + send via SnapshotBoundBalance.
# With --enable-sends set exactly one of:
# APPROVED_STRATEGY_CAP_WMNT_WEI=      # production mode
# APPROVED_CANARY_NOTIONAL_WMNT_WEI=   # canary mode (first funded canary)
# SHADOW_ASSUMED_CAPITAL_CAP_WMNT_WEI=10000000000000000000  # default 10 WMNT
# MAX_FEE_CAP_WEI=
# CANCEL_FEE_CAP_WEI=
