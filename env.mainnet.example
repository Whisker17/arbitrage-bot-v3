# Mantle mainnet configuration (WHI-776)
# Copy to `.env` and fill in real values. Never commit real URLs or keys.
#
# Declare the expected chain id. The bot fails closed if the connected RPC
# reports a different id (e.g. accidentally pointing at Sepolia 5003).
# Endpoint selection follows this id — mainnet vars are used; Sepolia vars are
# never consulted when BOT_CHAIN_ID=5000.
#
# Precedence (HTTP / WS):
#   1. RPC_HTTP_URL / RPC_WS_URL                (explicit override)
#   2. MANTLE_MAINNET_RPC_URL / _WS_URL         (canonical chain-specific)
#   3. MANTLE_RPC_URL / MANTLE_RPC_WS_URL       (legacy mainnet alias; WHI-745)
#   4. MANTLE_HTTP_URL / MANTLE_WS_URL          (legacy generic)
#   5. built-in mainnet default
BOT_CHAIN_ID=5000

# Preferred mainnet RPC pair (HTTP + WS).
MANTLE_MAINNET_RPC_URL=https://YOUR_MAINNET_HTTP_RPC
MANTLE_MAINNET_RPC_WS_URL=wss://YOUR_MAINNET_WS_RPC

# Legacy aliases still accepted when the canonical pair is unset:
# MANTLE_RPC_URL=https://YOUR_MAINNET_HTTP_RPC
# MANTLE_RPC_WS_URL=wss://YOUR_MAINNET_WS_RPC

# ArbitrageExecutor contract address (deployed mainnet executor)
ARBITRAGE_EXECUTOR_ADDRESS=

# WHI-532: Prometheus scrape endpoint for `cargo run --bin bot`.
# Process-local (not chain-scoped). The endpoint is UNAUTHENTICATED and
# unencrypted; default is loopback-only. Non-loopback binds require
# BOT_METRICS_ALLOW_PUBLIC_BIND=1 and an authenticating reverse proxy.
# BOT_METRICS_ADDR=127.0.0.1:9464
# BOT_METRICS_ALLOW_PUBLIC_BIND=0
# BOT_NO_METRICS=0
# BOT_METRICS_HOLD=0

# WHI-786: production HTTP RPC hardening (throttle / retry / timeout).
# RPC_HTTP_THROTTLE_RPS=250
# RPC_HTTP_RETRY_MAX=5
# RPC_HTTP_RETRY_INITIAL_BACKOFF_MS=200
# RPC_HTTP_RETRY_CUPS=330
# RPC_HTTP_REQUEST_TIMEOUT_MS=30000

# WHI-739 / WHI-535: shadow ledger (signerless). Required for --ledger.
# MANTLE_MAINNET_SHADOW_THRESHOLDS_PATH=config/gas_profiles/shadow_thresholds.mantle_mainnet.json
# SHADOW_LEDGER_PATH=logs/shadow_ledger.jsonl

# MUST remain unset for signerless shadow mode (SHADOW_MODE=1):
# MANTLE_SEPOLIA_PRIVATE_KEY=
# MANTLE_MAINNET_PRIVATE_KEY=
# MANTLE_PRIVATE_KEY=
# PRIVATE_KEY=
# EXECUTION_PRIVATE_KEY=
#
# WHI-860 production send path (default OFF). Opt in only after WHI-535 Approve
# and custody hardening. Never put the key in argv.
# BOT_ENABLE_SENDS=0
# BOT_HOT_EXECUTOR_PRIVATE_KEY=   # hot executor only — must ≠ contract admin
# BOT_SENDS_KILLED=0             # in-process kill switch (1 = halt sends)
# BREAKER_STORE_DIR=data/breaker
# MAX_LOSS_PER_WINDOW_WEI=
# MAX_INPUT_PER_TX_WMNT_WEI=
# MAX_TOTAL_INVENTORY_WMNT_WEI=
# MAX_FEE_CAP_WEI=
# CANCEL_FEE_CAP_WEI=
